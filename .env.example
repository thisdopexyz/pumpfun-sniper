# ============================================================
# PUMPFUN SNIPER — ENVIRONMENT VARIABLES
# ============================================================
# Copy to .env and fill in your values:
#   cp .env.example .env
# ============================================================
#
# IMPORTANT: This bot uses a Helius key POOL (HELIUS_EXTRA_KEYS) with no
# dedicated "primary" key. The first key in the list is used for the initial
# WebSocket connection; all keys (including the first) are rotated on 429 /
# reconnect. Helius free tier rate limits are per-API-key, so you need
# multiple keys to sustain burst buy activity. Provide at least 2-3 keys.
# ============================================================

# ---------------------------------------------------------------------------
# RPC ENDPOINTS
# ---------------------------------------------------------------------------

# Helius API key pool — comma-separated. First key = initial WS, all keys
# rotate on reconnect / 429. Get free keys at https://helius.dev
# Example with 3 keys: key1,key2,key3
HELIUS_EXTRA_KEYS=your_key_1,your_key_2,your_key_3

# FALLBACK #1: PublicNode (free, no auth)
PUBLICNODE_RPC_URL=https://solana-rpc.publicnode.com

# FALLBACK #2: Alchemy (optional — paid, leave empty to disable)
ALCHEMY_API_KEY=

# WebSocket (defaults to wss://mainnet.helius-rpc.com/?api-key=<first extra>)
# Set this to override the WS endpoint.
SOLANA_WS_URL=

# ---------------------------------------------------------------------------
# STORAGE
# ---------------------------------------------------------------------------

DATABASE_URL=postgresql://user:password@localhost:5432/pumpfun
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# WALLET
# ---------------------------------------------------------------------------

# Base64-encoded 64-byte secret key (Phantom exports as [1,2,3,...] array,
# convert with `bs58` or `solana-keygen` first, then base64 encode)
WALLET_SECRET_KEY=

# ---------------------------------------------------------------------------
# OPTIONAL
# ---------------------------------------------------------------------------

# Log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Node environment
NODE_ENV=production
